# Server
PORT=3000
NODE_ENV=development
BODY_LIMIT=25mb

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=crm_user
DB_PASSWORD=crm_password
DB_NAME=crm_db

# Optional database bootstrap
# Set to false to skip automatic database creation or migrations on startup.
AUTO_CREATE_DB=true
AUTO_MIGRATE=true
DB_ADMIN_DB=postgres
DB_ADMIN_USER=crm_user
DB_ADMIN_PASSWORD=crm_password

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
PAYMENT_TOKEN_EXPIRES_IN=8h

# Owner registration
# Must match ui VITE_OWNER_INVITE_KEY if owner self-registration is enabled.
OWNER_INVITE_KEY=owner-create-2026

# MongoDB request logging
# Local Docker from service/: mongodb://localhost:27017
# Root docker-compose backend container: mongodb://mongo:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB=crm_logs

# Optional: automatically expire request logs after N days (0 = keep forever).
REQUEST_LOG_TTL_DAYS=0

# System owner actions
# Enables owner-only dev reset endpoints for students, teachers, and classes.
# Production still blocks these endpoints even when this is true.
OWNER_DATA_RESET_ENABLED=true
# Required for POST /api/system/redeploy.
SERVER_REDEPLOY_PASSWORD=redeploy-password-2026
# Defaults to ../scripts/redeploy.sh from service cwd when empty.
SERVER_REDEPLOY_SCRIPT=../scripts/redeploy.sh

# Google Apps Script import/export integration
# GOOGLE_APPS_SCRIPT_URL is preferred; APPS_SCRIPT_URL is supported as a fallback.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxRmcCrmImportExportDeploymentId/exec
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxRmcCrmImportExportDeploymentId/exec

# Telegram bot integration
# Optional placeholders for bot support.
TELEGRAM_BOT_TOKEN=1234567890:AAExampleTelegramBotTokenForPrivateRepoSetup
TELEGRAM_BOT_USERNAME=rmc_crm_bot
TELEGRAM_WEBHOOK_URL=https://temurbek.m-kadirov.uz/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=telegram-webhook-secret-2026
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321

# Docker compose helper
# Used by the root docker-compose.yml port mapping, not by the service process.
BACKEND_PORT=3000

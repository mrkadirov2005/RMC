# @MOB-010 Copy to .env next to docker-compose.yml (mode 600, never committed) and fill in.
# docker-compose refuses to start when a required value is missing.

# Required. Keep the current production values when moving them here: the database volume was
# created with this password, and a new JWT_SECRET signs everyone out.
DB_PASSWORD=
JWT_SECRET=

# Owner self-registration key (registration is refused in production when empty).
OWNER_INVITE_KEY=

# Browser origins allowed to call the API (comma separated). Default: the web panel.
# CORS_ALLOWED_ORIGINS=https://temurbek.e-tizim.uz

# SMS to parents through the center's Android phone (SMS Gateway app). Empty: SMS is off.
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_DAILY_LIMIT=100

{
  "expo": {
    "name": "Temurbek School",
    "slug": "temurbek-school",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.temurbekschool.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F5BB5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "uz.temurbekschool.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1F5BB5",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "TEMURBEK SCHOOL records your spoken homework answers."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TEMURBEK SCHOOL attaches photos to your homework.",
          "cameraPermission": "TEMURBEK SCHOOL takes photos of your homework."
        }
      ],
      "@sentry/react-native"
    ],
    "scheme": "temurbekschool",
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}

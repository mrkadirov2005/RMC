TELEGRAM_BOT_TOKEN=123456:replace-with-your-bot-token

# The center's main channel. Users must join it before using the bot; add the bot to the channel
# as an admin so it can check membership. Leave empty to skip the check.
TELEGRAM_REQUIRED_CHANNEL=@your_channel

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=crm_user
DB_PASSWORD=crm_password
DB_NAME=crm_db

# Registrations are saved separately with this center id and class label.
BOT_DEFAULT_CENTER_ID=1
BOT_REGISTRATION_CLASS_LABEL=Unassigned

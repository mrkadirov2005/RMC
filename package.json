{
  "name": "rmc",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "typecheck": "cd ui && npx tsc -b && cd ../service && npx tsc --noEmit",
    "dev": "sh scripts/dev.sh ui",
    "dev:full": "sh scripts/dev.sh full",
    "dev:local": "sh scripts/dev-local.sh",
    "dev:local:db": "docker compose -f docker-compose.local.yml up -d --wait",
    "dev:local:stop": "docker compose -f docker-compose.local.yml stop",
    "dev:backend": "sh scripts/dev.sh backend",
    "dev:ui": "sh scripts/dev.sh ui",
    "dev:bot": "npm --prefix bot run dev",
    "build": "npm --prefix service run build && npm --prefix ui run build",
    "backup": "sh scripts/backup.sh",
    "backup:install-cron": "sh scripts/install-backup-cron.sh",
    "start": "npm --prefix service run start",
    "start:bot": "npm --prefix bot run start"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7"
  }
}

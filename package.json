{
  "name": "rmc",
  "private": true,
  "scripts": {
    "dev": "npm --prefix ui run dev",
    "dev:full": "concurrently -n backend,ui -c cyan,magenta \"npm --prefix service run dev\" \"npm --prefix ui run dev\"",
    "dev:backend": "npm --prefix service run dev",
    "dev:ui": "npm --prefix ui run dev",
    "dev:bot": "npm --prefix bot run dev",
    "build": "npm --prefix service run build && npm --prefix ui run build",
    "backup": "sh scripts/backup.sh",
    "backup:install-cron": "sh scripts/install-backup-cron.sh",
    "start": "npm --prefix service run start",
    "start:bot": "npm --prefix bot run start"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@tailwindcss/postcss": "^4.1.18"
  }
}
